class Student:
    def _init_(self, name, age):
        self.name = name
        self.age = age

class CollegeStudent(Student):
    def _init_(self, name, age, course):
        super()._init_(name, age)
        self.course = course

s = CollegeStudent("kprit", 18, "CSE")

print("Name:", s.name)
print("Age:", s.age)
print("Course:", s.course)
